# AMD build artefacts: these ARE committed. Moodle serves them at runtime and
# the CI validates them from the repo (thirdpartylibs.xml references the bundled
# editor). The amd/src sources build init.min.js via Grunt; editor_lazy.min.js is
# the prebuilt React bundle (esbuild). Both must be present in the repository.
# (Intentionally NOT ignoring amd/build/.)

# moodle-plugin-ci working directories
ci/
moodle/

